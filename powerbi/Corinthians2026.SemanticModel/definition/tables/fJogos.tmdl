		annotation UnderlyingDateTimeDataType = Date

	partition fJogos = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "jogos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"id_jogo", type text}, {"data", type date}, {"temporada", Int64.Type}, {"competicao", type text}, {"adversario", type text}, {"mando", type text}, {"gols_pro", Int64.Type}, {"gols_contra", Int64.Type}, {"resultado", type text}, {"pontos", Int64.Type}, {"decidido_penaltis", type text}, {"tecnico", type text}}, "en-US"),
				    Ordem = Table.AddColumn(Tipos, "ordem_resultado", each if [resultado] = "Vitória" then 1 else if [resultado] = "Empate" then 2 else 3, Int64.Type),
				    Resultado = Table.AddColumn(Ordem, "mes", each Date.StartOfMonth([data]), type date)
				in
				    Resultado

	annotation PBI_ResultType = Table

